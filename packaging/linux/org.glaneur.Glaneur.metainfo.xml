<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.glaneur.Glaneur</id>
  <name>Glaneur</name>
  <summary>Sync images from a WordPress or Djangoplicity site</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Desktop application to synchronise images from a remote media library — WordPress via its REST API, or a Djangoplicity site such as ESO, ESA/Hubble or ESA/Webb.</p>
  </description>
  <!-- Must match the name under which the .desktop file is INSTALLED in
       /app/share/applications, not the source name — the Flatpak manifest
       renames it to <app-id>.desktop per the convention. -->
  <launchable type="desktop-id">org.glaneur.Glaneur.desktop</launchable>
  <url type="homepage">https://github.com/penoud/Glaneur</url>
  <url type="bugtracker">https://github.com/penoud/Glaneur/issues</url>
  <developer id="org.glaneur">
    <name>Glaneur contributors</name>
  </developer>
  <releases>
